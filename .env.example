# ==============================================================================
# AWS SES (Simple Email Service) Notification Configuration
# ==============================================================================
# Set your AWS region and credentials for sending client automated emails.
# In production, these can be set as system environment variables or Lambda environment.
# ==============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=notifications@contractorhub.com

# Client-side (Vite) alternative overrides (optional)
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_FROM_EMAIL=notifications@contractorhub.com
